set(ADSBEE_TI_IMAGE "${CMAKE_SOURCE_DIR}/../ti/sub_ghz_radio/${ADSBEE_TI_BUILD_DIR}/sub_ghz_radio.bin")
set(ADSBEE_TI_PROTOCOL_FILE "${CMAKE_SOURCE_DIR}/../ti/sub_ghz_radio/${ADSBEE_TI_BUILD_DIR}/sub_ghz_radio.protocol")
if(NOT EXISTS "${ADSBEE_TI_PROTOCOL_FILE}")
    message(FATAL_ERROR "Missing ${ADSBEE_TI_PROTOCOL_FILE}; rebuild the TI firmware for ${ADSBEE_SUBGHZ_PROTOCOL}")
endif()
file(READ "${ADSBEE_TI_PROTOCOL_FILE}" ti_protocol)
string(STRIP "${ti_protocol}" ti_protocol)
if(NOT ti_protocol STREQUAL ADSBEE_SUBGHZ_PROTOCOL)
    message(FATAL_ERROR "CC1312 image uses ${ti_protocol}; rebuild TI for ${ADSBEE_SUBGHZ_PROTOCOL}")
endif()
